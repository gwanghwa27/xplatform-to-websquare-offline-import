+            ParsedLength top = isEmpty(g.top) ? null : parseLength(g.top);
+            ParsedLength height = isEmpty(g.height) ? null : parseLength(g.height);
+            if (top == null || height == null) {
+                continue;
+            }
+            double bottom = top.value + height.value;
+            if (bottom > maxBottom) {
+                maxBottom = bottom;
+            }
+        }
+        return maxBottom;
+    }
