<FDL version="1.5"><Form id="TransactionSample" width="400" height="200"><Objects><Dataset id="dsIn"><ColumnInfo><Column id="A" type="STRING"/></ColumnInfo></Dataset><Dataset id="dsOut"><ColumnInfo><Column id="B" type="STRING"/></ColumnInfo></Dataset></Objects><Script><![CDATA[
